#include <stdio.h>

int main() {
    int binary, decimal = 0, weight = 1, remainder;

    printf("Enter a binary number: ");
    scanf("%d", &binary);

    while (binary > 0) {
        remainder = binary % 10;
        decimal = decimal + remainder * weight;
        binary = binary / 10;
        weight = weight * 2;
    }

    printf("Decimal: %d\n", decimal);

    return 0;
}