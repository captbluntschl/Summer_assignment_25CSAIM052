#include <stdio.h>

int main() {
    int n;

    printf("Enter the value of N (total elements expected including the missing one): ");
    scanf("%d", &n);

    int size = n - 1;
    int arr[size];

    printf("Enter %d elements (from 1 to %d with one missing):\n", size, n);
    for (int i = 0; i < size; i++) {
        scanf("%d", &arr[i]);
    }

    int expectedSum = n * (n + 1) / 2;
    int actualSum = 0;

    for (int i = 0; i < size; i++) {
        actualSum += arr[i];
    }

    int missingNumber = expectedSum - actualSum;

    printf("The missing number is: %d\n", missingNumber);

    return 0;
}