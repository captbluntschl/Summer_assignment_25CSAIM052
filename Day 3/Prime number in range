#include <stdio.h>
int main()
{
    int first, last, i, j, count;
    printf("Enter starting number: ");
    scanf("%d", &first);
    printf("Enter ending number: ");
    scanf("%d", &last);
    printf("Prime numbers between %d and %d are:\n", first, last);
    for (i = first; i <= last; i++) 
    {
        count = 0;
        for (j = 1; j <= i; j++)
        {
            if (i % j == 0) 
            {
                count++;
            }
        }
        if (count == 2) {
            printf("%d ", i);
        }
    }
    printf("\n");
    return 0;
}
