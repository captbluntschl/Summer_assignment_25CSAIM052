#include <stdio.h>
int main()
{ 
    int num,pal,rem,reverse=0;
    printf("Enter the number");
    scanf("%d",&num);
    pal=num;
    while(num>0)
    {
        rem=num%10;
        reverse=(reverse*10)+rem;
        num=num/10;
    }
    if(pal==reverse)
    { 
        printf("%d is a palindrome");
    }
    else
    {
        printf("%d is not a palindome");
    }
    return 0;
}