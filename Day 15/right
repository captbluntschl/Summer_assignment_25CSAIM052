#include <stdio.h>

int main() {
    int size, positions;

    printf("Enter the size of the array: ");
    scanf("%d", &size);

    int arr[size];

    printf("Enter %d elements:\n", size);
    for (int i = 0; i < size; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter the number of positions to rotate right: ");
    scanf("%d", &positions);

    positions = positions % size;
    if (positions < 0) {
        positions = positions + size;
    }

    int temp[positions];
    for (int i = 0; i < positions; i++) {
        temp[i] = arr[size - positions + i];
    }

    for (int i = size - 1; i >= positions; i--) {
        arr[i] = arr[i - positions];
    }

    for (int i = 0; i < positions; i++) {
        arr[i] = temp[i];
    }

    printf("The right-rotated array is: ");
    for (int i = 0; i < size; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}