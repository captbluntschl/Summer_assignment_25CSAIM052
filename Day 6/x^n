#include <stdio.h>

int main() {
    double base, result = 1.0;
    int exponent;

    printf("Enter base: ");
    scanf("%lf", &base);
    printf("Enter exponent: ");
    scanf("%d", &exponent);

    int n = exponent;
    if (n < 0) {
        n = -n;
    }

    for (int i = 0; i < n; i++) {
        result *= base;
    }

    if (exponent < 0) {
        result = 1.0 / result;
    }

    printf("Result: %.6lf\n", result);

    return 0;
}
