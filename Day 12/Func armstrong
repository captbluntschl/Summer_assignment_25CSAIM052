#include <stdio.h>

int isArmstrong(int n) {
    int original = n, remainder, sum = 0, digits = 0;
    int temp = n;

    while (temp > 0) {
        digits++;
        temp = temp / 10;
    }

    temp = original;
    while (temp > 0) {
        remainder = temp % 10;
        
        int power = 1;
        for (int i = 0; i < digits; i++) {
            power *= remainder;
        }
        
        sum += power;
        temp = temp / 10;
    }

    if (sum == original) {
        return 1;
    } else {
        return 0;
    }
}

int main() {
    int num;

    printf("Enter a number: ");
    scanf("%d", &num);

    if (num < 0) {
        printf("%d is not an Armstrong number.\n", num);
    } else if (isArmstrong(num)) {
        printf("%d is an Armstrong number.\n", num);
    } else {
        printf("%d is not an Armstrong number.\n", num);
    }

    return 0;
}